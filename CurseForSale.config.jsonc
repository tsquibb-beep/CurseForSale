// CurseForSale - settings. With the dev console open, `cfs reload` applies changes
// without restarting.
//
// Copy this file to your save folder to keep your settings through mod updates:
//   %APPDATA%\SlayTheSpire2\CurseForSale.config.jsonc
// That copy is read in preference to this one.
//
// Lengths are fractions of the card removal coin's width.
{
    // Master switch for the whole mod.
    "enabled": true,

    // Only show the effect when you have enough gold for the removal.
    "onlyWhenAffordable": true,

    // The glow behind the coin: its outer colour (the same as shadowColor, so the glow
    // matches the smoke on the coin) and the colour right next to the coin.
    "auraColor": "#1f0533",
    "auraCoreColor": "#2b0a3d",

    // Opacity of the glow. 0 hides it.
    "auraStrength": 1.0,

    // How far the glow reaches past the coin, and how far smoke lifts it upwards.
    "auraReach": 0.26,
    "auraLift": 0.07,

    // How much the glow breathes in and out. 0 keeps it steady.
    "auraPulse": 0.12,

    // The overlay on the coin: colour of the drifting dark wisps, and of the light
    // purple wash over the whole coin.
    "shadowColor": "#1f0533",
    "tintColor": "#6b249e",

    // Opacity of the whole overlay. 0 hides it.
    "shadowStrength": 1.0,

    // Darkness of the wisps, of the shadow creeping in from the rim, and strength
    // of the purple wash.
    "wispStrength": 0.7,
    "rimStrength": 0.5,
    "tintStrength": 0.1,

    // Light reaching out from behind the coin:
    //   "rays"     - pink shafts that waver and turn slowly
    //   "duotone"  - pink rays turning one way, green rays the other
    //   "tendrils" - wisps drifting outwards, green at the coin and pink at the tips
    //   "streak"   - a lens flare: a pink streak and spikes with a broken green ring
    //   "none"     - no flare
    // With the dev console open, `cfs flare tendrils` (etc.) tries a style without
    // editing this file.
    "flare": "duotone",

    // The flare's pink and green.
    "flareColor": "#e0459a",
    "flareColor2": "#5fe08a",

    // Brightness of the flare (0 hides it), and how far it reaches past the coin.
    "flareStrength": 0.9,
    "flareReach": 0.55,

    // How fast the smoke moves. 0 freezes it.
    "speed": 0.45,

    // Fade in/out time in seconds.
    "fadeSeconds": 0.4
}
